# Copy to .env in this folder (run commands from backend/).

DEBUG=0
APP_NAME=Career Copilot

# Browser clients (SSE). Comma-separated origins, or * for any (credentials disabled with *).
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (SQLAlchemy + Alembic). Example uses psycopg3 driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/career_copilot

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# LangSmith / LangChain tracing (optional). Use your LangSmith API key for LANGCHAIN_API_KEY.
LANGCHAIN_TRACING_V2=0
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=career-copilot

# Input limits (optional). Est. tokens ~= character_count / 4.
MAX_USER_INPUT_CHARS=48000
MAX_USER_ESTIMATED_TOKENS=12000
GRAPH_CHECKPOINT_SQLITE_PATH=.data/langgraph_checkpoints.sqlite

# Llama Prompt Guard 2 — loaded at app startup (see app.guardrails). Gated model: accept Meta license on Hugging Face.
HF_TOKEN=
# HUGGINGFACE_TOKEN=   # optional alternative to HF_TOKEN
# PROMPT_GUARD_MODEL_ID=meta-llama/Llama-Prompt-Guard-2-86M
# PROMPT_GUARD_DEVICE=-1

# Per-agent LLM settings (nested: AGENTS__<AGENT>__<FIELD>).
# Agents: planner, research, analyst, critic, synthesizer, feedback.
# Fields: temperature, max_tokens, model, model_provider.

AGENTS__PLANNER__TEMPERATURE=0.7
AGENTS__PLANNER__MAX_TOKENS=4096
AGENTS__PLANNER__MODEL=gpt-4o-mini
AGENTS__PLANNER__MODEL_PROVIDER=openai

AGENTS__RESEARCH__TEMPERATURE=0.7
AGENTS__RESEARCH__MAX_TOKENS=4096
AGENTS__RESEARCH__MODEL=gpt-4o-mini
AGENTS__RESEARCH__MODEL_PROVIDER=openai

AGENTS__ANALYST__TEMPERATURE=0.7
AGENTS__ANALYST__MAX_TOKENS=4096
AGENTS__ANALYST__MODEL=gpt-4o-mini
AGENTS__ANALYST__MODEL_PROVIDER=openai

AGENTS__CRITIC__TEMPERATURE=0.7
AGENTS__CRITIC__MAX_TOKENS=4096
AGENTS__CRITIC__MODEL=gpt-4o-mini
AGENTS__CRITIC__MODEL_PROVIDER=openai

AGENTS__SYNTHESIZER__TEMPERATURE=0.7
AGENTS__SYNTHESIZER__MAX_TOKENS=4096
AGENTS__SYNTHESIZER__MODEL=gpt-4o-mini
AGENTS__SYNTHESIZER__MODEL_PROVIDER=openai

AGENTS__FEEDBACK__TEMPERATURE=0.7
AGENTS__FEEDBACK__MAX_TOKENS=4096
AGENTS__FEEDBACK__MODEL=gpt-4o-mini
AGENTS__FEEDBACK__MODEL_PROVIDER=openai
