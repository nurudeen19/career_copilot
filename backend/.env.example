# Copy to .env in this folder (run commands from backend/).

APP_NAME=Career Copilot
DEBUG=True
LOG_LEVEL=INFO
# Rotating file log (app.log). Default is backend/logs; use an absolute path on servers (e.g. /logs).
# LOG_FILE_DIR=/logs
# LOG_FILE_ENABLED=1

# Browser clients (SSE). Comma-separated origins, or * for any (credentials disabled with *).
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (SQLAlchemy + Alembic). Example uses psycopg3 driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/career_copilot

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# SlowAPI (nested RATE_LIMITS__*). Format: "N/minute". RATE_LIMITS__ENABLED=0 disables throttling.
RATE_LIMITS__ENABLED=1
RATE_LIMITS__LOGIN=10/minute
RATE_LIMITS__SIGNUP=5/minute
RATE_LIMITS__AUTH_EMAIL=5/minute
RATE_LIMITS__VERIFY_EMAIL=10/minute
RATE_LIMITS__RESET_PASSWORD=10/minute
RATE_LIMITS__PROFILE=10/minute
RATE_LIMITS__WORKFLOW_STREAM=6/minute
RATE_LIMITS__HEALTH=60/minute

# SPA origin (no trailing slash). Verification and password-reset emails link here; the SPA POSTs to the API.
FRONTEND_APP_BASE_URL=http://localhost:5173

# Mailtrap Sending API (https://mailtrap.io) — live transactional sending token.
MAILTRAP_API_TOKEN=
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=Career Copilot

OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# LangSmith / LangChain tracing (optional). Use your LangSmith API key for LANGCHAIN_API_KEY.
# LangSmith also reads LANGSMITH_API_KEY / LANGSMITH_TRACING_V2 if set on the process environment;
# keys in this file must match Settings (LANGCHAIN_* below) to be loaded into the app.
LANGCHAIN_TRACING_V2=0
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=career-copilot

# Workflow / graph (nested under WORKFLOW__). Est. tokens ~= character_count / 4.
WORKFLOW__MAX_USER_INPUT_CHARS=48000
WORKFLOW__MAX_USER_ESTIMATED_TOKENS=12000
WORKFLOW__GRAPH_CHECKPOINT_SQLITE_PATH=.data/langgraph_checkpoints.sqlite

# Prompt guard (HF). HF_TOKEN PROMPT_GUARD__MODEL_ID / __DEVICE.
HF_TOKEN=
PROMPT_GUARD__MODEL_ID=meta-llama/Llama-Prompt-Guard-2-86M
PROMPT_GUARD__DEVICE=-1

# Per-agent LLM settings (nested: AGENTS__<AGENT>__<FIELD>).
# Agents: planner, research, analyst, critic, synthesizer, feedback.
# Fields: temperature, max_tokens, model, model_provider.
AGENTS__PLANNER__TEMPERATURE=0.7
AGENTS__PLANNER__MAX_TOKENS=1000 
AGENTS__PLANNER__MODEL=gpt-4o-mini
AGENTS__PLANNER__MODEL_PROVIDER=openai
# Optional per-agent LangChain fallback (both required). Example: OpenAI primary, Groq backup.
# AGENTS__PLANNER__FALLBACK_MODEL=llama-3.1-8b-instant
# AGENTS__PLANNER__FALLBACK_MODEL_PROVIDER=groq

AGENTS__RESEARCH__TEMPERATURE=0.7
AGENTS__RESEARCH__MAX_TOKENS=2500
AGENTS__RESEARCH__MODEL=gpt-4o-mini
AGENTS__RESEARCH__MODEL_PROVIDER=openai
# AGENTS__RESEARCH__FALLBACK_MODEL=gemini-2.5-flash
# AGENTS__RESEARCH__FALLBACK_MODEL_PROVIDER=google

AGENTS__ANALYST__TEMPERATURE=0.7
AGENTS__ANALYST__MAX_TOKENS=2000
AGENTS__ANALYST__MODEL=gpt-4o-mini
AGENTS__ANALYST__MODEL_PROVIDER=openai
# AGENTS__ANALYST__FALLBACK_MODEL=gemini-2.5-flash
# AGENTS__ANALYST__FALLBACK_MODEL_PROVIDER=google

AGENTS__CRITIC__TEMPERATURE=0.7
AGENTS__CRITIC__MAX_TOKENS=2000
AGENTS__CRITIC__MODEL=gpt-4o-mini
AGENTS__CRITIC__MODEL_PROVIDER=openai
# AGENTS__CRITIC__FALLBACK_MODEL=gemini-2.5-flash
# AGENTS__CRITIC__FALLBACK_MODEL_PROVIDER=google

AGENTS__SYNTHESIZER__TEMPERATURE=0.7
AGENTS__SYNTHESIZER__MAX_TOKENS=2500
AGENTS__SYNTHESIZER__MODEL=gpt-4o-mini
AGENTS__SYNTHESIZER__MODEL_PROVIDER=openai
# AGENTS__SYNTHESIZER__FALLBACK_MODEL=gemini-2.5-flash
# AGENTS__SYNTHESIZER__FALLBACK_MODEL_PROVIDER=google

AGENTS__FEEDBACK__TEMPERATURE=0.7
AGENTS__FEEDBACK__MAX_TOKENS=1000
AGENTS__FEEDBACK__MODEL=gpt-4o-mini
AGENTS__FEEDBACK__MODEL_PROVIDER=openai
# AGENTS__FEEDBACK__FALLBACK_MODEL=gemini-2.5-flash
# AGENTS__FEEDBACK__FALLBACK_MODEL_PROVIDER=google