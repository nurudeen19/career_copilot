# Copy to .env (run from backend/). Flat keys; LLM + per-role agent fields live on settings.agents (same env names).

APP_NAME=Career Copilot
DEBUG=True
LOG_LEVEL=INFO
# Default: colored UTC lines on terminal; JSON lines in app.log (when LOG_FILE_ENABLED). No extra setup.
# LOG_FILE_JSON=false     # plain text in app.log (legacy alias: LOG_JSON=false)
# LOG_CONSOLE_JSON=true   # stderr JSON instead of colors (e.g. log aggregation)
# LOG_COLOR=false         # disable ANSI on terminal (NO_COLOR env also disables)
# LOG_FILE_DIR=/logs
# LOG_FILE_ENABLED=1

# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/career_copilot

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# SlowAPI. Format: "N/minute". RATE_LIMIT_ENABLED=0 disables throttling.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_AUTH_EMAIL=5/minute
RATE_LIMIT_VERIFY_EMAIL=10/minute
RATE_LIMIT_RESET_PASSWORD=10/minute
RATE_LIMIT_PROFILE=10/minute
RATE_LIMIT_WORKFLOW_STREAM=6/minute
RATE_LIMIT_HEALTH=60/minute

FRONTEND_APP_BASE_URL=http://localhost:5173

MAILTRAP_API_TOKEN=
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=Career Copilot

OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

LANGSMITH_TRACING_V2=true
# LANGSMITH_TRACING_ENABLED=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-copilot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_URL=

# Workflow / graph. Est. tokens ~= character_count / 4.
MAX_USER_INPUT_CHARS=48000
MAX_USER_ESTIMATED_TOKENS=12000
GRAPH_CHECKPOINT_SQLITE_PATH=.data/langgraph_checkpoints.sqlite
# Max approximate tokens of **chat history** for the planner only (full thread stays in checkpoint).
LLM_HISTORY_MAX_TOKENS=12000

# Prompt guard (HF). Model fields below; token via HF_TOKEN (or HUGGING_FACE_HUB_TOKEN).
HF_TOKEN=
PROMPT_GUARD_MODEL_ID=meta-llama/Llama-Prompt-Guard-2-86M
PROMPT_GUARD_DEVICE=-1
# Block when softmax P(malicious) >= this (see Meta llama-cookbook prompt_guard/inference.py). Lower = stricter.
PROMPT_GUARD_MALICIOUS_THRESHOLD=0.35
# By default user_feedback (thumbs-down marker, corrections) is only size-checked — not HF-scanned (fewer false blocks).
# PROMPT_GUARD_CLASSIFY_USER_FEEDBACK=true

# Per-agent LLM (prefix: PLANNER_, RESEARCH_, ANALYST_, CRITIC_, SYNTHESIZER_).
# Fields: TEMPERATURE, MAX_TOKENS, MODEL, MODEL_PROVIDER; optional FALLBACK_MODEL + FALLBACK_MODEL_PROVIDER.
PLANNER_TEMPERATURE=0.7
PLANNER_MAX_TOKENS=1000
PLANNER_MODEL=gpt-4o-mini
PLANNER_MODEL_PROVIDER=openai
# PLANNER_FALLBACK_MODEL=llama-3.1-8b-instant
# PLANNER_FALLBACK_MODEL_PROVIDER=groq

RESEARCH_TEMPERATURE=0.7
RESEARCH_MAX_TOKENS=2500
RESEARCH_MODEL=gpt-4o-mini
RESEARCH_MODEL_PROVIDER=openai

ANALYST_TEMPERATURE=0.7
ANALYST_MAX_TOKENS=2000
ANALYST_MODEL=gpt-4o-mini
ANALYST_MODEL_PROVIDER=openai

CRITIC_TEMPERATURE=0.7
CRITIC_MAX_TOKENS=2000
CRITIC_MODEL=gpt-4o-mini
CRITIC_MODEL_PROVIDER=openai

SYNTHESIZER_TEMPERATURE=0.7
SYNTHESIZER_MAX_TOKENS=2500
SYNTHESIZER_MODEL=gpt-4o-mini
SYNTHESIZER_MODEL_PROVIDER=openai
